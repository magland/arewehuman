{
  "name": "arewehuman",
  "displayName": "arewehuman",
  "description": "Record the provenance of every character you write in a Markdown file in VS Code's editor, and replay it.",
  "version": "0.0.1",
  "publisher": "magland",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/magland/arewehuman" },
  "engines": { "vscode": "^1.97.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished", "onLanguage:markdown"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "arewehuman.viewer",
        "displayName": "arewehuman replay",
        "selector": [{ "filenamePattern": "*.prov.json" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "arewehuman.newDocument", "title": "New Recorded Document…", "category": "arewehuman" },
      { "command": "arewehuman.record", "title": "Record with arewehuman", "category": "arewehuman", "icon": "$(record)" },
      { "command": "arewehuman.replay", "title": "Show Replay", "category": "arewehuman", "icon": "$(play-circle)" },
      { "command": "arewehuman.toggleHighlight", "title": "Toggle Highlighting of Non-Typed Text", "category": "arewehuman" }
    ],
    "menus": {
      "editor/title": [
        { "command": "arewehuman.replay", "when": "arewehuman.recording", "group": "navigation@2" },
        { "command": "arewehuman.record", "when": "editorLangId == markdown && resourceExtname == .md && !arewehuman.recording", "group": "navigation@9" }
      ],
      "explorer/context": [
        { "command": "arewehuman.record", "when": "resourceExtname == .md", "group": "navigation@9" },
        { "command": "arewehuman.newDocument", "when": "explorerResourceIsFolder", "group": "navigation@9" }
      ],
      "commandPalette": [
        { "command": "arewehuman.replay", "when": "arewehuman.recording" }
      ]
    },
    "configuration": {
      "title": "arewehuman",
      "properties": {
        "arewehuman.highlightNonTyped": {
          "type": "boolean",
          "default": true,
          "description": "Highlight text in recorded documents that was not typed (pasted, copied, imported or other)."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "~1.97.0",
    "esbuild": "^0.28.2"
  }
}
