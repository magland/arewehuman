{
  "name": "arewehuman",
  "displayName": "arewehuman",
  "description": "Record the provenance of every character you write in a Markdown file, and replay it.",
  "version": "0.0.1",
  "publisher": "magland",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/magland/arewehuman" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "arewehuman.editor",
        "displayName": "arewehuman (recording)",
        "selector": [{ "filenamePattern": "*.md" }],
        "priority": "option"
      },
      {
        "viewType": "arewehuman.viewer",
        "displayName": "arewehuman replay",
        "selector": [{ "filenamePattern": "*.prov.json" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "arewehuman.newDocument", "title": "New Recorded Document…", "category": "arewehuman" },
      { "command": "arewehuman.record", "title": "Record with arewehuman", "category": "arewehuman", "icon": "$(record)" },
      { "command": "arewehuman.openAsText", "title": "Reopen as Plain Text (Not Recorded)", "category": "arewehuman", "icon": "$(go-to-file)" },
      { "command": "arewehuman.preview", "title": "Open Markdown Preview to the Side", "category": "arewehuman", "icon": "$(open-preview)" },
      { "command": "arewehuman.replay", "title": "Show Replay", "category": "arewehuman", "icon": "$(play-circle)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "arewehuman.preview", "when": "activeCustomEditorId == arewehuman.editor", "group": "navigation@1" },
        { "command": "arewehuman.replay", "when": "activeCustomEditorId == arewehuman.editor", "group": "navigation@2" },
        { "command": "arewehuman.openAsText", "when": "activeCustomEditorId == arewehuman.editor", "group": "navigation@3" },
        { "command": "arewehuman.record", "when": "editorLangId == markdown && resourceExtname == .md", "group": "navigation@9" }
      ],
      "explorer/context": [
        { "command": "arewehuman.record", "when": "resourceExtname == .md", "group": "navigation@9" },
        { "command": "arewehuman.newDocument", "when": "explorerResourceIsFolder", "group": "navigation@9" }
      ],
      "commandPalette": [
        { "command": "arewehuman.openAsText", "when": "activeCustomEditorId == arewehuman.editor" },
        { "command": "arewehuman.preview", "when": "activeCustomEditorId == arewehuman.editor" },
        { "command": "arewehuman.replay", "when": "activeCustomEditorId == arewehuman.editor" }
      ]
    },
    "configuration": {
      "title": "arewehuman",
      "properties": {
        "arewehuman.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open a .md file in the recording editor when a .prov.json file with the same name sits next to it."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.28.2"
  }
}
